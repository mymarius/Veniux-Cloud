# Production settings are generated in the external data directory by Install-Windows.ps1.
# Do not put credentials in the release folder or version control.
# All values intentionally blank. This file cannot start the server.
# Install-Windows generates production/sqlite/127.0.0.1/3000 and private keys outside the release.
NODE_ENV=
DB_ENGINE=
HOST=
PORT=
VENIUX_DATA_DIR=
JWT_SECRET=
LICENSE_PRIVATE_KEY_PATH=
LICENSE_PUBLIC_KEY_PATH=
# Optional providers: enter existing credentials only in the private install.env.
NVIDIA_API_KEY=
GEMINI_API_KEY=
FISH_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORS_ORIGIN=
WHATSAPP_BROWSER_PATH=
