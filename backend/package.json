{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "mysql:migrate": "node --env-file-if-exists=.env scripts/mysql_migrate.js",
    "mysql:import": "node --env-file-if-exists=.env scripts/sqlite_to_mysql.js",
    "mysql:ledger-backfill": "node --env-file-if-exists=.env scripts/mysql_ledger_backfill.js",
    "test:mysql": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.mysql.config.cjs --runInBand",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --setupFilesAfterEnv=./tests/setup.js",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@google/generative-ai": "^0.24.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "lowdb": "^7.0.1",
    "mysql2": "^3.24.2",
    "node-cron": "^4.6.0",
    "node-sql-parser": "^5.4.0",
    "nodemailer": "10.3.1",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "soap": "^1.13.2",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "whatsapp-web.js": {
      "puppeteer": "25.16.0",
      "archiver": "8.0.0",
      "minimatch": "11.0.4"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "zod": "4.6.7"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.11.1": true,
    "unrs-resolver@1.12.2": true
  }
}
