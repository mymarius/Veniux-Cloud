Options -Indexes
AddType text/vtt .vtt
AddType video/mp4 .mp4
DirectoryIndex index.php
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.veniux\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://veniux.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^api\.veniux\.com(?:/|$) - [F,L]
RewriteRule ^(?:config|router|contact|smtp|check-mail|pricing|pricing-view|accounts|owner-identity|seo|program-view|footer|legal|legal-view|release-notes|release-notes-view|release-catalog|release-archive|release-archive-view|terminal-guide|requestFirewall|asset-manifest|guide-view|use-cases|organic-guides|sponsor|hosting-guide|conversion|product-proof|growth-pages|growth-view|growth-evidence|product-faqs|release-live|home-view|home-film|analytics-config|sector-pages|sector-view).php$ - [F,L]
RewriteRule ^assets/[a-zA-Z0-9._-]+$ - [L]
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
<FilesMatch "^(?:[a-z]+\.[a-f0-9]{12}\.(?:css|js)|logo-(?:[0-9]+|hero(?:-[0-9]+)?)-v[0-9]+\.webp|product-(?:barcode|warehouse|lot|expiry|terminal)-v[0-9]+\.jpg|sector-(?:market|kirtasiye|hirdavat|kafe)-v[0-9]+\.jpg|manrope-v1\.woff2|hostimux-sponsor-v1\.png)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Sürüm parametreli betik ve stil dosyaları (?v=...) bir gün önbellekte kalır, sonra doğrulanır; yazı tipi ve görseller 30 gün.
<FilesMatch "^(?:home\.(?:css|js)|chat(?:-admin)?\.js|veniux-site\.css|cookie-consent\.css|release-notes\.js)$">
Header setifempty Cache-Control "public, max-age=86400, must-revalidate"
</FilesMatch>
<FilesMatch "\.(?:woff2|png|webp|jpg|jpeg|svg|ico|mp4|vtt)$">
Header setifempty Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

